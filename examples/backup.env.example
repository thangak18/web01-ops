# Copy to /etc/backup.env, edit, then:
# sudo chown root:root /etc/backup.env
# sudo chmod 600 /etc/backup.env

DATA_DIR="$HOME/web01-data"
ALERT_TO="student@example.com"

# Local fallback:
DEST="/srv/backup-target"
# Remote example instead:
# DEST="backupuser@backup01:/srv/web01-backups"

RETAIN_DAYS=7

# auto | msmtp | mail | log
MAIL_MODE="log"
MAIL_LOG="/var/log/web01-alerts.log"

# Set true only for the Task 3 forced-error demonstration.
FORCE_FAILURE=false
