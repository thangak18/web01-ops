# Copy to /etc/monitoring.env, edit, then:
# sudo chown root:root /etc/monitoring.env
# sudo chmod 600 /etc/monitoring.env

ALERT_TO="student@example.com"
DISK_THRESHOLD=85
RAM_MIN_FREE=15

# Ubuntu commonly uses: ssh cron
# CentOS Stream commonly uses: sshd crond
SERVICES="ssh cron"
HEALTH_URL="http://localhost:8080"

# auto | msmtp | mail | log
MAIL_MODE="log"
MAIL_LOG="/var/log/web01-alerts.log"
